    "Covers Zoom, Slack, Webex and browser meetings with no per-app setup. Coarser: it cannot read a meeting title, and a muted participant may not register." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deckt Zoom, Slack, Webex und Besprechungen im Browser ohne Einrichtung pro App ab. Ungenauer: Der Besprechungstitel kann nicht gelesen werden, und ein stummgeschalteter Teilnehmer wird möglicherweise nicht erkannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Covers Zoom, Slack, Webex and browser meetings with no per-app setup. Coarser: it cannot read a meeting title, and a muted participant may not register."
          }
        }
      }
    },
