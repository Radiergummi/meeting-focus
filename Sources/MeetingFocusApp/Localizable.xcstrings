    "Back-to-back meetings are normal. Waiting avoids releasing your Focus during a short gap between two calls." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aufeinanderfolgende Besprechungen sind normal. Die Wartezeit verhindert, dass der Fokus in einer kurzen Pause zwischen zwei Anrufen beendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
