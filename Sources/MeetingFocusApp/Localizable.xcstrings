    },
    "MeetingFocus will add two shortcuts — one to turn Do Not Disturb on when a meeting starts, one to turn it off when it ends — and Shortcuts will ask you to confirm each." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeetingFocus fügt zwei Kurzbefehle hinzu — einen, der „Nicht stören“ zu Beginn einer Besprechung einschaltet, und einen, der es am Ende wieder ausschaltet — und die Kurzbefehle-App bittet dich, jeden zu bestätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeetingFocus will add two shortcuts — one to turn Do Not Disturb on when a meeting starts, one to turn it off when it ends — and Shortcuts will ask you to confirm each."
          }
        }
      }
    },
